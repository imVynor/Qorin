# QORIN Frontend Environment Configuration
# ==========================================
# In local development with Vite dev proxy (default):
# VITE_API_URL=/api
#
# When connecting directly to a local backend:
# VITE_API_URL=http://127.0.0.1:8000/api
#
# When connecting to a deployed remote backend service:
# VITE_API_URL=https://api.yourdomain.com/api
#
# GitHub Pages base path override (defaults to '/' locally, '/Qorin/' in GitHub Actions):
# VITE_BASE_PATH=/Qorin/
