# ==============================================================================
# QORIN Repository .gitignore
# ==============================================================================

# Node / Frontend Build Outputs
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
build/
*.local
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Local Secrets
.env
.env.*
!.env.example
!.env.test
*.env.local
.secrets.json
**/.secrets.json

# Python Environments, Caches & Bytecode
.venv/
venv/
env/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Model Weights, Binary Checkpoints & Tensor Dumps (>50MB / GB-scale)
# Note: Checkpoints are hosted publicly on Hugging Face (vynor/qorin-models)
*.pt
*.pth
*.ckpt*
*.bin
*.safetensors
*.onnx
*.h5
*.tflite
*.joblib
*.pkl
checkpoints/
**/checkpoints/
**/runs/

# Large Training Datasets, Tokenized Shards & Corpora
*.jsonl
*.parquet
*.arrow
*.tar
*.tar.gz
*.gz
*.zip
modern-gpt-instruction-data/
modergpt/
modern_gpt/archive/
modern_gpt/artifacts/
modern_gpt/data/
modern_gpt/data_*/
modern_gpt/logs/
gpt2/gpt2/124M/

# Databases, Transient Cache & Sandboxes
*.db
*.sqlite
*.sqlite3
backend/data/sandbox/
backend/tools/retrieval_cache.sqlite

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ephemeral Backup & Temp Files
*.tmp
*.bak
*.bak_*

# AI Planning Artifacts & Internal Scratch Workspaces
artifacts/
**/artifacts/
scratch/
**/scratch/
QORIN_*.md
website_content_inventory.md
FINAL_DEPLOYMENT_SECURITY_GATE.md
HF_DEPLOYMENT_FINAL_REPORT.md

# Web Temporary Verification Files
web/*.png
!web/src/assets/*.png
web/screenshot_*.png
web/debug_capture.cjs
web/test_*.cjs
web/verify_*.cjs
